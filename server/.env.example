# 像素豆 PixelBean 后端环境变量示例
# 复制为 .env 并填入真实值（生产环境切勿提交 .env 到仓库）

# 监听端口（云平台通常用环境变量注入 PORT，留空则用 4000）
PORT=4000

# 运行模式：production 时不再把验证码回传前端
NODE_ENV=development

# JWT 签名密钥（生产环境务必改成强随机串，可用 `openssl rand -hex 32` 生成）
JWT_SECRET=pixelbean-dev-secret-change-me

# 允许的跨域源（逗号分隔）；同源部署（由本服务托管前端）填 * 即可
# 生产示例：ALLOWED_ORIGIN=https://your-site.com
ALLOWED_ORIGIN=*

# ===== 稳定运营（可选，但强烈建议生产配置） =====

# 备份端点鉴权令牌：设置后 /api/admin/backup 才启用（用 x-admin-token 头携带）。
# 可留空，则备份端点返回 403。
ADMIN_TOKEN=

# SQLite 备份目录（默认 server/data/backups）；定时备份与手动备份都落这里
BACKUP_DIR=

# 定时在线备份间隔（毫秒，默认 21600000 = 6 小时）
BACKUP_INTERVAL_MS=21600000

# 监控告警 Webhook：monitor.js 探测到服务异常时 POST 告警到该地址
# 例如企业微信机器人：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
ALERT_WEBHOOK=

# 图形验证码开关：注册/发码前的人机校验，防机器批量刷短信。
# 默认「生产开 / 开发关」；设为 true 强制开启（含开发），false 强制关闭。
CAPTCHA_ENABLED=

